# Copy to .env and fill in. Never commit real keys.

# MAE AI chat (Gemini). When unset or blank, `npm run dev` serves clearly-labelled demo replies
# (header X-MAE-AI-Mode: mock); in production/Vercel the endpoint answers 503 instead.
GEMINI_API_KEY=
# Optional override; defaults to the gemini-flash-latest alias (versioned names get retired for new keys).
# GEMINI_MODEL=
# Several keys can be rotated: GEMINI_KEYS=key1,key2,key3 (takes precedence over GEMINI_API_KEY).
# Fallback cascade, tried in order only when the main model is overloaded (503), out of quota (429) or unavailable (404)
# on every key. Default: gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
# (retired models are skipped). A comma list overrides it; empty/off disables the cascade.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flashgemini-flash-latest

# Circuit analysis (/api/ai/analyze)
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
