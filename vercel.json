      "destination": "/prerendered/terms-of-service.html"
    },
    {
      "source": "/attribution-policy",
      "destination": "/prerendered/attribution-policy.html"
    },
    {
      "source": "/(research|library|courses|code|assembler|simulations|simulators|fluid-drive|about|contact|privacy|privacy-policy|terms|terms-of-service|attribution-policy)(/.*)?",
      "destination": "/spa-shell.html"
    }
  ]
}
